ent": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}], "template_override": 1}, {"questions": [{"_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn5le16ob06re7pdf01.pdf"}]}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Let's talk about the future. What will you do next year?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"id": 0, "_data": [], "template_override": 1, "type": "welcome", "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le16ob06re2aud01", "coverimg": "engenn5le16ob06re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le16ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Hi. I'm looking for Marisa Mitchell.<br/>\n<span class=\"strong\">Marisa</span>: Hi! I'm Marisa, the production manager. You must be Sally.<br/>\n<span class=\"strong\">Sally</span>: Yes. Hi. Very nice to meet you. I'm here for the meet and greet.<br/>\n<span class=\"strong\">Marisa</span>: Welcome to the team.  Let me show you around.<br/>\n<span class=\"strong\">Sally</span>: OK.", "id": 1, "time": "100", "image": "engenn5le16ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Marisa</span>: We'll start with your office.<br/>\n<span class=\"strong\">Sally</span>: Could you clarify that please? Is it my own?<br/>\n<span class=\"strong\">Marisa</span>:  Not quite. This is an office shared by the freelancers, but you'll all be in on different days.<br/>\n<span class=\"strong\">Sally</span>: I'm not quite sure I know what you mean.<br/>\n<span class=\"strong\">Marisa</span>: What I mean is that there might be times when you get the office all to yourself.<br/>\n<span class=\"strong\">Sally</span>: Ah, I see what you mean. Does the entire editorial team work here?<br/>\n<span class=\"strong\">Marisa</span>: Not everyone, but most of us do. You'll meet your boss today. You may meet the art director and the photographers. They're here every now and then.<br/>\n<span class=\"strong\">Sally</span>: Cool.", "id": 2, "time": "19500", "image": "engenn5le16ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Marisa</span>: I'll introduce you to our copy editor and proofreaders. You may want to get acquainted with them quickly.<br/>\n<span class=\"strong\">Sally</span>: Do you mean that I'll be writing soon?<br/>\n<span class=\"strong\">Marisa</span>: I don't see why not. Speaking of... there's Victoria. She's the right person to ask about that.", "id": 3, "time": "60000", "image": "engenn5le16ob06re2img01.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally Gets a Job at a Magazine"}, {"type": "unit_name", "content": "Welcome to the Team"}, {"type": "position", "content": 6}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 16}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe characteristics of different people and their jobs."}, {"type": "secondary_1", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_2", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_3", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_4", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_5", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_6", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_7", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_8", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}]}, {"type": "background_image", "content": "engenn5le16ob06re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Will, May, Might"}, {"type": "describer", "content": "You use the Future tense (<span class=\"strong\">will</span>) to talk about actions you are going to do in the future.<br/><br/>You use the Future tense when you talk about the future, make offers or make predictions.<br/><br/>The modals <span class=\"strong\">might</span> and <span class=\"strong\">may</span> go before the verb. <br/><br/>They talk about future possibility or a chance that something will happen. <br/><br/><span class=\"strong\">Might</span> means there is a smaller chance that something will happen (30%).<br/><br/><span class=\"strong\">May</span> means there is a slightly greater chance that something will happen (50%)."}, {"type": "example", "content": "I will show you around the office. "}, {"type": "example", "content": "You might meet a few members of the team. "}, {"type": "example", "content": "We may meet Ms. Ryan in the afternoon."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Asking for Clarification"}, {"type": "describer", "content": " If you don't understand what a person is saying, it is important to ask for clarification in a polite way.<br/><br/>Here are some expressions you can use to ask for clarification:"}, {"type": "text", "content": "<ul> <li><span class=\"italic\">I'm not quite sure I know what you mean.</span></li> <li><span class=\"italic\">Are you asking \u2026?</span></li> <li><span class=\"italic\">What do you mean by...?</span></li> <li><span class=\"italic\">Do you mean...?</span></li> <li><span class=\"italic\">Could you clarify that?</span></li> <li><span class=\"italic\">Could you give me an example?</span></li></ul>"}, {"type": "example", "content": "<span class=\"strong\">Sally</span>: Is this the office the journalists use?<br/> <span class=\"strong\">Marisa</span>: Are you asking if this is your office?<br/><span class=\"strong\">Sally</span>: Yes. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "production manager"}, {"type": "definition", "content": "the person that is responsible for making sure all the deadlines are met  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I'm the production manager for the magazine."}, {"type": "audio", "content": "engenn5le16ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about jobs. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "editorial team"}, {"type": "definition", "content": "the group of people that are responsible for preparing text material for the magazine  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The entire editorial team works in this office. "}, {"type": "audio", "content": "engenn5le16ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "art director"}, {"type": "definition", "content": "the person that is responsible for all of the artwork that is included in the magazine "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You may meet the art director at some point. "}, {"type": "audio", "content": "engenn5le16ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "photographer"}, {"type": "definition", "content": " the person that is responsible for taking photos for the magazine "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are two photographers for our team. "}, {"type": "audio", "content": "engenn5le16ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "copy editor"}, {"type": "definition", "content": " the person that is responsible for checking the quality of text material in the magazine "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The copy editor is very strict. "}, {"type": "audio", "content": "engenn5le16ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "proofreader"}, {"type": "definition", "content": "the person that is responsible for checking all the text materials for correct grammar and spelling "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The proofreader works closely with the copy editor. "}, {"type": "audio", "content": "engenn5le16ob06aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be acquainted with"}, {"type": "definition", "content": "to become familiar with  "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: You will want to become acquainted with the team. "}, {"type": "audio", "content": "engenn5le16ob06aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write a dialogue (10-12 lines) between you and a friend."}, {"type": "text", "content": "Talk about what you want to become or do in the future."}, {"type": "text", "content": "Ask for clarification at least 2 times."}, {"type": "text", "content": "Find a partner and practice reading your dialogue aloud."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about what I'm doing in the future."}, {"type": "text", "content": "I ask a friend for clarification. "}, {"type": "text", "content": "I talk to a friend about jobs."}]}], "type": "sena"}