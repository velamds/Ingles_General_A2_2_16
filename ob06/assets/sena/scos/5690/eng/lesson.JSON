{"_data": [{"type": "metadata", "contents": [{"content": "Sally Gets a Job at a Magazine", "type": "lesson_name"}, {"content": "Welcome to the Team", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "A2.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_1"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_2"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_3"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_4"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_5"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_6"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_7"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_8"}]}, {"content": "engenn5le16ob06re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Will, May, Might", "type": "heading"}, {"content": "You use the Future tense (<span class=\"strong\">will</span>) to talk about actions you are going to do in the future.<br/><br/>You use the Future tense when you talk about the future, make offers or make predictions.<br/><br/>The modals <span class=\"strong\">might</span> and <span class=\"strong\">may</span> go before the verb. <br/><br/>They talk about future possibility or a chance that something will happen. <br/><br/><span class=\"strong\">Might</span> means there is a smaller chance that something will happen (30%).<br/><br/><span class=\"strong\">May</span> means there is a slightly greater chance that something will happen (50%).", "type": "describer"}, {"content": "I will show you around the office. ", "type": "example"}, {"content": "You might meet a few members of the team. ", "type": "example"}, {"content": "We may meet Ms. Ryan in the afternoon.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Asking for Clarification", "type": "heading"}, {"content": " If you don't understand what a person is saying, it is important to ask for clarification in a polite way.<br/><br/>Here are some expressions you can use to ask for clarification:", "type": "describer"}, {"content": "<ul> <li><span class=\"italic\">I'm not quite sure I know what you mean.</span></li> <li><span class=\"italic\">Are you asking \u2026 ?</span></li> <li><span class=\"italic\">What do you mean by ... ?</span></li> <li><span class=\"italic\">Do you mean ... ?</span></li> <li><span class=\"italic\">Could you clarify that?</span></li> <li><span class=\"italic\">Could you give me an example?</span></li></ul>", "type": "text"}, {"content": "<span class=\"strong\">Sally</span>: Is this the office the journalists use?<br/> <span class=\"strong\">Marisa</span>: Are you asking if this is your office?<br/><span class=\"strong\">Sally</span>: Yes. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "production manager", "type": "name"}, {"content": "the person that is responsible for making sure all the deadlines are met  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm the production manager for the magazine.", "type": "example"}, {"content": "engenn5le16ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about jobs. ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "editorial team", "type": "name"}, {"content": "the group of people that are responsible for preparing text material for the magazine  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The entire editorial team works in this office. ", "type": "example"}, {"content": "engenn5le16ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "art director", "type": "name"}, {"content": "the person that is responsible for all of the artwork that is included in the magazine ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You may meet the art director at some point. ", "type": "example"}, {"content": "engenn5le16ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "photographer", "type": "name"}, {"content": " the person that is responsible for taking photos for the magazine ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There are two photographers for our team. ", "type": "example"}, {"content": "engenn5le16ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "copy editor", "type": "name"}, {"content": " the person that is responsible for checking the quality of text material in the magazine ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The copy editor is very strict. ", "type": "example"}, {"content": "engenn5le16ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "proofreader", "type": "name"}, {"content": "the person that is responsible for checking all the text materials for correct grammar and spelling ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The proofreader works closely with the copy editor. ", "type": "example"}, {"content": "engenn5le16ob06aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to be acquainted with", "type": "name"}, {"content": "to become familiar with  ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You will want to become acquainted with the team. ", "type": "example"}, {"content": "engenn5le16ob06aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a dialogue (10-12 lines) between you and a friend.", "type": "text"}, {"content": "Talk about what you want to become or do in the future.", "type": "text"}, {"content": "Ask for clarification at least 2 times.", "type": "text"}, {"content": "Find a partner and practice reading your dialogue aloud.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about what I'm doing in the future.", "type": "text"}, {"content": "I ask a friend for clarification. ", "type": "text"}, {"content": "I talk to a friend about jobs.", "type": "text"}]}], "labs": [{"exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": "I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": "I can say what I'm doing in the future.", "type": "Learning Outcomes"}, {"content": "I can ask for clarifications.", "type": "Learning Outcomes"}, {"content": "Would you like to work in a small quiet office or a large busy one? Why?", "type": "Fre