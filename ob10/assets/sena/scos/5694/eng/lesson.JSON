ect!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le16ob10re2img05.jpg"}, {"text": "<span class=\"strong\">Waiter</span>: Are you ready to order?<br/>\n<span class=\"strong\">Sally</span>: I'd like the falafel tacos.<br/>\n<span class=\"strong\">Waiter</span>: Sorry, I didn't quite hear that. Can you repeat what you said please?<br/>\n<span class=\"strong\">Sally</span>: I would like the falafel tacos. <br/>\n<span class=\"strong\">Waiter</span>: And you?<br/>\n<span class=\"strong\">Peter</span>: I'll have the crab cakes.<br/>\n<span class=\"strong\">Waiter</span>: Would you like me to fill up your drinks?<br/>\n<span class=\"strong\">Sally</span>: Not at the moment. Can I have a cola, please?<br/>\n<span class=\"strong\">Waiter</span>: Certainly. Could I get some more water for you?<br/>\n<span class=\"strong\">Peter</span>: Yes, please.", "id": 1, "time": "100", "image": "engenn5le16ob10re2img05.jpg"}, {"text": "<span class=\"strong\">Waiter</span>: Anything else?<br/>\n<span class=\"strong\">Peter</span>: Actually, would I be able to get a side order of sweet potato fries as well please?<br/>\n<span class=\"strong\">Waiter</span>: Certainly. What dipping sauce would you like with it?<br/>\n<span class=\"strong\">Peter</span>: Could you be more specific please? What are my choices?<br/>\n<span class=\"strong\">Waiter</span>: Ketchup, honey, chipotle mayo, or a garlic aioli.<br/>\n<span class=\"strong\">Peter</span>: Garlic aioli? Would you elaborate on that please?<br/>\n<span class=\"strong\">Waiter</span>: It's made of mayo, crushed garlic, cayenne and fresh lemon juice.<br/>\n<span class=\"strong\">Peter</span>: Thanks. I'll have the chipotle mayo please.", "id": 2, "time": "30000", "image": "engenn5le16ob10re2img05.jpg"}, {"text": "<span class=\"strong\">Waiter</span>: Here is your food. Enjoy your meal.<br/>\n<span class=\"strong\">Sally</span>: Thank you.<br/>\n<span class=\"strong\">Waiter</span>: How was everything?<br/>\n<span class=\"strong\">Peter</span>: Delicious, thanks.<br/>\n<span class=\"strong\">Waiter</span>: Would you like anything for dessert?<br/>\n<span class=\"strong\">Sally</span>: No, thanks.", "id": 3, "time": "70000", "image": "engenn5le16ob10re1img01.jpg"}], "audiosrc": "engenn5le16ob10re2aud01", "coverimg": "engenn5le16ob10re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": {"images": [], "audiosrc": "engenn5le16ob10re6aud01", "coverimg": "engenn5le16ob10re6img04.jpg"}, "type": "picture"}], "_data": [], "type": "audio", "template_override": 1}]}]}