{"_data": [{"contents": [{"content": "Sally Gets a Job at a Magazine", "type": "lesson_name"}, {"content": "Working at a Magazine?", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about people's jobs and places of work in communicative situations.", "type": "primary"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_1"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_2"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_3"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_5"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_6"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_7"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le16ob01re1img01.jpg", "type": "background_image"}, {"contents": [{"content": " Will, May, Might", "type": "heading"}, {"content": "You use the Future tense (<span class=\"strong\">will</span>) to talk about actions in the future. You can also use the modals <span class=\"strong\">might</span> and <span class=\"strong\">may</span> to talk about possible actions in the future.", "type": "describer"}, {"content": "The auxiliary <span class=\"strong\">will</span> goes before the verb. The short form is 'll.<br/><br/> You use the Future tense when you talk about the future, make offers or make predictions.<br/><br/>The modals <span class=\"strong\">might</span> and <span class=\"strong\">may</span> go before the verb.<br/> <br/>They talk about future possibility or a chance that something will happen.<br/> <br/><span class=\"strong\">Might</span> means there is a smaller chance that something will happen (30%).<br/> <br/><span class=\"strong\">May</span> means there is a slightly greater chance that something will happen (50%).", "type": "text"}, {"content": "I might write a cookbook. ", "type": "example"}, {"content": "I will move back to Boston next year.  ", "type": "example"}, {"content": "They may open a restaurant. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Expressing Opinions", "type": "heading"}, {"content": " You use these expressions to express an opinion:", "type": "describer"}, {"content": "<span class=\"italic\">I think\u2026</span><br/><br/> <span class=\"italic\">In my opinion \u2026</span><br/><br/> <span class=\"italic\">I'm pretty sure \u2026</span><br/><br/> <span class=\"italic\">The way I see it \u2026</span><br/><br/> <span class=\"italic\">I have no doubt that ...</span>", "type": "text"}, {"content": "I really think I did well. ", "type": "example"}, {"content": "I have no doubt that you got the job. ", "type": "example"}, {"content": "The way I see it they'll definitely hire you. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "magazine", "type": "name"}, {"content": "a large thin book that contains news stories, articles and photographs", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: I'll work for a magazine. ", "type": "example"}, {"content": "engenn5le16ob01aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to talk about work.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "freelance ", "type": "name"}, {"content": "work independently for a company ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I applied for a freelance position. ", "type": "example"}, {"content": "engenn5le16ob01aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "journalist", "type": "name"}, {"content": "someone who writes for newspapers or magazines ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This job is the first step in becoming a journalist. ", "type": "example"}, {"content": "engenn5le16ob01aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to hire", "type": "name"}, {"content": "to employ someone to do a specific job ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: They are going to hire you as their new writer.", "type": "example"}, {"content": "engenn5le16ob01aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "start ", "type": "name"}, {"content": "the beginning of someone's job, which they will develop in the future ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This will be a great start to my career.", "type": "example"}, {"content": "engenn5le16ob01aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "food critic", "type": "name"}, {"content": "someone whose job is to make judgments about the dishes served in restaurants ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You love to eat food, you should become a food critic. ", "type": "example"}, {"content": "engenn5le16ob01aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to open up", "type": "name"}, {"content": "to make available to the public ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I might open up a restaurant in the city.", "type": "example"}, {"content": "engenn5le16ob01aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Go on the Internet. ", "type": "text"}, {"content": "Find 4 crazy jobs. Write them down in the table below. ", "type": "text"}, {"content": "Read about them. ", "type": "text"}, {"content": "What's your opinion about each of them? Write 2-3 sentences for each job. Remember to use an expression to introduce your opinion.", "type": "text"}, {"content": "Share your opinions with a partner.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Job \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"My Opinion\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"&nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}], "type": "takeaway_extension"}, {"contents": [{"content": "I research different jobs on the Internet. ", "type": "text"}, {"content": "I write down my opinion about different jobs.", "type": "text"}, {"content": "I introduce my opinion using an expression.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le16ob01re2img06.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le16ob01re2img06.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Sally</span>: Hey! Remember that freelance position I was telling you about? The one I applied to?<br/>\n<span class=\"strong\">Vanessa</span>: Yeah.<br/>\n<span class=\"strong\">Sally</span>: They called me in for an interview this morning.<br/>"}, {"image": "engenn5le16ob01re2img06.jpg", "time": "9500", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Sweet! How'd it go?<br/>\n<span class=\"strong\">Sally</span>: Ah, I was nervous. I really think I let my nerves get the best of me.<br/>\n<span class=\"strong\">Vanessa</span>: No way! I have no doubt that you did well. I definitely think they're going to hire you.<br/>\n<span class=\"strong\">Sally</span>: I hope so. This would be a great start to my career as a journalist.<br/>\n<span class=\"strong\">Vanessa</span>: I'm pretty sure you'll get the job, but if you don't, you might want to consider becoming a food critic."}, {"image": "engenn5le16ob01re2img01.jpg", "time": "35500", "id": 3, "text": "<span class=\"strong\">Sally</span>: Of course, and then I can write about your restaurant and its wonderful dishes.<br/>\n<span class=\"strong\">Vanessa</span>: Cute, but the way I see it, I won't open up my own restaurant anytime soon. I may move back to Cambridge.<br/>\n<span class=\"strong\">Sally</span>: When will you come back?<br/>\n<span class=\"strong\">Vanessa</span>: I might come back in a few months.<br/>\n<span class=\"strong\">Sally</span>: That'd be great!<br/>\n<span class=\"strong\">Vanessa</span>: But only if you'll promise to help me write my cookbook."}], "audiosrc": "engenn5le16ob01re2aud01", "coverimg": "engenn5le16ob01re2img06.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work. ", "type": "Learning Outcomes"}, {"content": " I can say what I'm doing in the future. ", "type": "Learning Outcomes"}, {"content": " I can introduce an opinion. ", "type": "Learning Outcomes"}, {"content": " Do you think you might like to work for a magazine?  Why or why not? ", "type": "Free Header Item"}, {"content": "Would you ever like to be a boss or manager of a company? Why or why not?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": " Stories, photos, articles. Which do you prefer?", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": "  Sally and Vanessa talk about their future plans. ", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback"